# ─── Mountain Explorer — Ortam Değişkenleri ──────────────────────────────────
# Bu dosyayı kopyalayın: cp .env.example .env
# Sonra değerleri doldurun.

# OpenTopography API anahtarı (terrain eğim/bakı analizi için)
# Ücretsiz hesap: https://portal.opentopography.org/requestApiKey
# İsteğe bağlı — doldurmadan da 3D küre çalışır
OPENTOPO_API_KEY=
